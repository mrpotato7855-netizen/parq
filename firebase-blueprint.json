{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with username, display name, online presence, and privacy settings.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Authenticated user UID" },
        "username": { "type": "string", "description": "Unique username identifier without @" },
        "displayName": { "type": "string", "description": "Display name of the user" },
        "bio": { "type": "string", "description": "Bio or about status text" },
        "avatarUrl": { "type": "string", "description": "Profile picture URL or preset identifier" },
        "isOnline": { "type": "boolean", "description": "Online presence flag" },
        "lastSeen": { "type": "string", "format": "date-time", "description": "Last seen timestamp" },
        "lastSeenPrivacy": { "type": "string", "description": "Privacy for last seen: everyone, contacts, nobody" },
        "avatarPrivacy": { "type": "string", "description": "Privacy for avatar: everyone, nobody" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account creation time" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update time" }
      },
      "required": ["userId", "username", "displayName", "createdAt", "updatedAt"]
    },
    "Chat": {
      "title": "Chat",
      "description": "Conversation container for direct 1-on-1 chats, groups, and broadcast channels.",
      "type": "object",
      "properties": {
        "chatId": { "type": "string", "description": "Unique chat ID" },
        "type": { "type": "string", "description": "Chat type: direct, group, or channel" },
        "name": { "type": "string", "description": "Group or channel name" },
        "about": { "type": "string", "description": "Group or channel description" },
        "avatarUrl": { "type": "string", "description": "Group or channel avatar URL" },
        "channelUsername": { "type": "string", "description": "Public channel username" },
        "ownerId": { "type": "string", "description": "Creator UID" },
        "participantUids": { "type": "array", "description": "List of participant user IDs" },
        "adminUids": { "type": "array", "description": "List of admin user IDs" },
        "lastMessage": { "type": "string", "description": "Snippet of the last message" },
        "lastMessageSenderId": { "type": "string", "description": "UID of last message sender" },
        "lastMessageTime": { "type": "string", "format": "date-time", "description": "Timestamp of last message" },
        "lastMessageType": { "type": "string", "description": "Type of last message" },
        "pinnedMessageId": { "type": "string", "description": "Pinned message ID in this chat" },
        "isPublic": { "type": "boolean", "description": "Flag for public discovery" },
        "inviteLink": { "type": "string", "description": "Shareable invite link" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["chatId", "type", "ownerId", "participantUids", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Message item in a chat: text, photo, voice note, document, location, or sticker.",
      "type": "object",
      "properties": {
        "messageId": { "type": "string", "description": "Message document ID" },
        "chatId": { "type": "string", "description": "Parent chat ID" },
        "senderId": { "type": "string", "description": "UID of sender" },
        "senderName": { "type": "string", "description": "Display name of sender" },
        "senderAvatar": { "type": "string", "description": "Sender avatar URL" },
        "type": { "type": "string", "description": "Message type: text, image, voice, document, location, sticker" },
        "content": { "type": "string", "description": "Text body or media description" },
        "mediaUrl": { "type": "string", "description": "Attached media URL or data" },
        "fileName": { "type": "string", "description": "Document filename" },
        "fileSize": { "type": "integer", "description": "File size in bytes" },
        "durationSec": { "type": "integer", "description": "Voice note duration in seconds" },
        "latitude": { "type": "number", "description": "Location latitude" },
        "longitude": { "type": "number", "description": "Location longitude" },
        "replyToMessageId": { "type": "string", "description": "Quoted message ID" },
        "replyToText": { "type": "string", "description": "Quoted message text preview" },
        "replyToSenderName": { "type": "string", "description": "Quoted message sender name" },
        "forwardedFrom": { "type": "string", "description": "Source name if forwarded" },
        "status": { "type": "string", "description": "Delivery status: sent, delivered, read" },
        "isEdited": { "type": "boolean", "description": "True if edited" },
        "viewsCount": { "type": "integer", "description": "View count for channel posts" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["messageId", "chatId", "senderId", "type", "content", "status", "createdAt", "updatedAt"]
    },
    "ChatSettings": {
      "title": "ChatSettings",
      "description": "User specific chat configuration such as archive and mute status.",
      "type": "object",
      "properties": {
        "chatId": { "type": "string", "description": "Associated chat ID" },
        "isArchived": { "type": "boolean", "description": "Whether chat is archived" },
        "isMuted": { "type": "boolean", "description": "Whether chat notifications are muted" },
        "pinned": { "type": "boolean", "description": "Whether chat is pinned to top" },
        "unreadCount": { "type": "integer", "description": "Number of unread messages" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["chatId", "updatedAt"]
    },
    "Contact": {
      "title": "Contact",
      "description": "Saved user contact.",
      "type": "object",
      "properties": {
        "contactUid": { "type": "string", "description": "UID of contact" },
        "contactUsername": { "type": "string", "description": "Username of contact" },
        "contactName": { "type": "string", "description": "Custom or display name of contact" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["contactUid", "contactUsername", "contactName", "createdAt"]
    },
    "BlockedUser": {
      "title": "BlockedUser",
      "description": "User blocked by the current user.",
      "type": "object",
      "properties": {
        "blockedUid": { "type": "string", "description": "UID of blocked user" },
        "blockedUsername": { "type": "string", "description": "Username of blocked user" },
        "blockedName": { "type": "string", "description": "Name of blocked user" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["blockedUid", "createdAt"]
    },
    "TypingStatus": {
      "title": "TypingStatus",
      "description": "Realtime indicator when a participant is typing in a chat.",
      "type": "object",
      "properties": {
        "chatId": { "type": "string", "description": "Target chat ID" },
        "userId": { "type": "string", "description": "UID of typing user" },
        "userName": { "type": "string", "description": "Display name of typing user" },
        "isTyping": { "type": "boolean", "description": "Typing active flag" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["chatId", "userId", "isTyping", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile collection."
    },
    "/users/{userId}/chatSettings/{chatId}": {
      "schema": { "$ref": "#/entities/ChatSettings" },
      "description": "Per-user chat preferences."
    },
    "/users/{userId}/contacts/{contactUid}": {
      "schema": { "$ref": "#/entities/Contact" },
      "description": "Per-user saved contacts."
    },
    "/users/{userId}/blockedUsers/{blockedUid}": {
      "schema": { "$ref": "#/entities/BlockedUser" },
      "description": "Per-user blocked accounts."
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/Chat" },
      "description": "Chats, groups, and channels."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Messages inside a chat."
    },
    "/typingStatus/{statusId}": {
      "schema": { "$ref": "#/entities/TypingStatus" },
      "description": "Ephemeral typing status indicator."
    }
  }
}
