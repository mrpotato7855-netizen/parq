rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.username is string && data.username.size() >= 3 && data.username.size() <= 35 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             (!('bio' in data) || data.bio == null || (data.bio is string && data.bio.size() <= 300)) &&
             (!('avatarUrl' in data) || data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 2000)) &&
             (!('isOnline' in data) || data.isOnline is bool) &&
             (!('lastSeen' in data) || data.lastSeen == null || (data.lastSeen is timestamp && data.lastSeen <= request.time)) &&
             (!('lastSeenPrivacy' in data) || (data.lastSeenPrivacy in ['everyone', 'contacts', 'nobody'])) &&
             (!('avatarPrivacy' in data) || (data.avatarPrivacy in ['everyone', 'nobody']));
    }

    function isValidChat(data) {
      return data.chatId is string && data.chatId.size() <= 128 &&
             data.type in ['direct', 'group', 'channel'] &&
             data.ownerId is string && data.ownerId.size() <= 128 &&
             data.participantUids is list && data.participantUids.size() <= 200 &&
             (!('adminUids' in data) || (data.adminUids is list && data.adminUids.size() <= 50)) &&
             (!('adminPermissions' in data) || data.adminPermissions is map) &&
             (!('name' in data) || data.name == null || (data.name is string && data.name.size() <= 100)) &&
             (!('about' in data) || data.about == null || (data.about is string && data.about.size() <= 500)) &&
             (!('avatarUrl' in data) || data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 2000)) &&
             (!('coverUrl' in data) || data.coverUrl == null || (data.coverUrl is string && data.coverUrl.size() <= 2000)) &&
             (!('channelUsername' in data) || data.channelUsername == null || (data.channelUsername is string && data.channelUsername.size() <= 40)) &&
             (!('lastMessage' in data) || data.lastMessage == null || (data.lastMessage is string && data.lastMessage.size() <= 500)) &&
             (!('lastMessageSenderId' in data) || data.lastMessageSenderId == null || (data.lastMessageSenderId is string && data.lastMessageSenderId.size() <= 128)) &&
             (!('lastMessageTime' in data) || data.lastMessageTime == null || (data.lastMessageTime is timestamp && data.lastMessageTime <= request.time)) &&
             (!('lastMessageType' in data) || data.lastMessageType == null || (data.lastMessageType is string && data.lastMessageType.size() <= 30)) &&
             (!('pinnedMessageId' in data) || data.pinnedMessageId == null || (data.pinnedMessageId is string && data.pinnedMessageId.size() <= 128)) &&
             (!('isPublic' in data) || data.isPublic is bool) &&
             (!('onlyAdminsCanPost' in data) || data.onlyAdminsCanPost is bool) &&
             (!('joinRequiresApproval' in data) || data.joinRequiresApproval is bool) &&
             (!('isSavedMessages' in data) || data.isSavedMessages is bool) &&
             (!('inviteLink' in data) || data.inviteLink == null || (data.inviteLink is string && data.inviteLink.size() <= 300));
    }

    function isValidMessage(data) {
      return data.messageId is string && data.messageId.size() <= 128 &&
             data.chatId is string && data.chatId.size() <= 128 &&
             data.senderId is string && data.senderId.size() <= 128 &&
             data.type in ['text', 'image', 'video', 'voice', 'document', 'location', 'live_location', 'sticker'] &&
             data.content is string && data.content.size() <= 5000 &&
             data.status in ['sent', 'delivered', 'read'] &&
             (!('senderName' in data) || data.senderName == null || (data.senderName is string && data.senderName.size() <= 60)) &&
             (!('senderAvatar' in data) || data.senderAvatar == null || (data.senderAvatar is string && data.senderAvatar.size() <= 2000)) &&
             (!('mediaUrl' in data) || data.mediaUrl == null || (data.mediaUrl is string && data.mediaUrl.size() <= 3000)) &&
             (!('fileName' in data) || data.fileName == null || (data.fileName is string && data.fileName.size() <= 150)) &&
             (!('fileSize' in data) || data.fileSize == null || data.fileSize is int) &&
             (!('durationSec' in data) || data.durationSec == null || data.durationSec is int) &&
             (!('latitude' in data) || data.latitude == null || (data.latitude is number)) &&
             (!('longitude' in data) || data.longitude == null || (data.longitude is number)) &&
             (!('isLiveLocation' in data) || data.isLiveLocation is bool) &&
             (!('liveLocationActive' in data) || data.liveLocationActive is bool) &&
             (!('liveLocationExpiresAt' in data) || data.liveLocationExpiresAt == null || data.liveLocationExpiresAt is int) &&
             (!('replyToMessageId' in data) || data.replyToMessageId == null || (data.replyToMessageId is string && data.replyToMessageId.size() <= 128)) &&
             (!('replyToText' in data) || data.replyToText == null || (data.replyToText is string && data.replyToText.size() <= 300)) &&
             (!('replyToSenderName' in data) || data.replyToSenderName == null || (data.replyToSenderName is string && data.replyToSenderName.size() <= 60)) &&
             (!('forwardedFrom' in data) || data.forwardedFrom == null || (data.forwardedFrom is string && data.forwardedFrom.size() <= 60)) &&
             (!('isEdited' in data) || data.isEdited is bool) &&
             (!('viewsCount' in data) || data.viewsCount is int);
    }

    function isChatParticipantOrPublic(chatId) {
      return exists(/databases/$(database)/documents/chats/$(chatId)) && (
        get(/databases/$(database)/documents/chats/$(chatId)).data.isPublic == true ||
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids
      );
    }

    function isChatOwnerOrAdmin(chatId) {
      return exists(/databases/$(database)/documents/chats/$(chatId)) && (
        request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId ||
        ('adminUids' in get(/databases/$(database)/documents/chats/$(chatId)).data &&
         request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.adminUids)
      );
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == userId &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidUser(incoming());
      allow update: if isOwner(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidUser(incoming());
      allow delete: if isOwner(userId);

      match /chatSettings/{chatId} {
        allow read, write: if isOwner(userId);
      }

      match /contacts/{contactUid} {
        allow read, write: if isOwner(userId);
      }

      match /blockedUsers/{blockedUid} {
        allow read, write: if isOwner(userId);
      }

      match /fcmTokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /reports/{reportId} {
      allow create: if isSignedIn() && incoming().reporterUid == request.auth.uid;
      allow read: if isSignedIn() && resource.data.reporterUid == request.auth.uid;
    }

    match /chats/{chatId} {
      allow get: if isSignedIn() && (
        resource == null ||
        resource.data.isPublic == true ||
        request.auth.uid in resource.data.participantUids
      );
      allow list: if isSignedIn() && (
        resource.data.isPublic == true ||
        request.auth.uid in resource.data.participantUids
      );
      allow create: if isSignedIn() &&
                       request.auth.uid == incoming().ownerId &&
                       request.auth.uid in incoming().participantUids &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidChat(incoming());
      allow update: if isSignedIn() && (
        request.auth.uid == existing().ownerId ||
        ('adminUids' in existing() && request.auth.uid in existing().adminUids) ||
        (request.auth.uid in existing().participantUids &&
          incoming().ownerId == existing().ownerId &&
          incoming().participantUids == existing().participantUids &&
          (!('adminUids' in existing()) || incoming().adminUids == existing().adminUids)) ||
        (existing().isPublic == true &&
          incoming().ownerId == existing().ownerId &&
          request.auth.uid in incoming().participantUids)
      ) &&
      incoming().createdAt == existing().createdAt &&
      incoming().updatedAt is timestamp &&
      incoming().updatedAt <= request.time &&
      isValidChat(incoming());
      allow delete: if isSignedIn() && request.auth.uid == existing().ownerId;

      match /messages/{messageId} {
        allow read: if isSignedIn() && isChatParticipantOrPublic(chatId);
        allow create: if isSignedIn() &&
                         isChatParticipantOrPublic(chatId) &&
                         incoming().senderId == request.auth.uid &&
                         incoming().chatId == chatId &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         isValidMessage(incoming());
        allow update: if isSignedIn() && isChatParticipantOrPublic(chatId) && (
          request.auth.uid == existing().senderId ||
          incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount', 'status', 'updatedAt'])
        ) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt is timestamp &&
        incoming().updatedAt <= request.time &&
        isValidMessage(incoming());
        allow delete: if isSignedIn() && (
          request.auth.uid == existing().senderId ||
          isChatOwnerOrAdmin(chatId)
        );
      }
    }

    match /typingStatus/{statusId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() &&
                               incoming().userId == request.auth.uid &&
                               incoming().updatedAt is timestamp &&
                               incoming().updatedAt <= request.time;
      allow delete: if isSignedIn() && (resource == null || existing().userId == request.auth.uid);
    }
  }
}
